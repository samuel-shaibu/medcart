# Copy this to .env and fill in your values
# cp .env.example .env

# ─── Arduino serial port ──────────────────────────────────────────────────────
# On RPi: usually /dev/ttyUSB0 (CH340) or /dev/ttyACM0 (official Arduino)
# Check with: ls /dev/tty* before and after plugging in Arduino
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUD=9600

# ─── MQTT broker (Mosquitto running on RPi) ───────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883

# ─── Telegram bot ────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here